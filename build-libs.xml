<?xml version="1.0" encoding="UTF-8"?>
<!--
  外部ライブラリを Maven Central から lib/ に取得する。
  バージョンは pom.xml の <properties> から読む（バージョン管理は pom.xml に一本化）。
-->
<project name="libs" default="fetch" basedir=".">
    <property name="lib.dir" value="${basedir}/lib"/>
    <property name="central" value="https://repo1.maven.org/maven2"/>

    <!-- pom.xml の <properties><tomcat.version> は ${pom.properties.tomcat.version} になる -->
    <xmlproperty file="${basedir}/pom.xml" prefix="pom" keepRoot="false"/>
    <property name="tomcat.version" value="${pom.properties.tomcat.version}"/>
    <property name="ecj.version" value="${pom.properties.ecj.version}"/>

    <target name="clean">
        <delete dir="${lib.dir}"/>
    </target>

    <target name="fetch">
        <echo message="tomcat.version=${tomcat.version} / ecj.version=${ecj.version} (from pom.xml)"/>
        <!-- バージョンが変わったときに古い jar が残らないよう毎回取り直す -->
        <delete dir="${lib.dir}"/>
        <mkdir dir="${lib.dir}"/>
        <get dest="${lib.dir}" usetimestamp="false">
            <url url="${central}/org/apache/tomcat/embed/tomcat-embed-core/${tomcat.version}/tomcat-embed-core-${tomcat.version}.jar"/>
            <url url="${central}/org/apache/tomcat/embed/tomcat-embed-jasper/${tomcat.version}/tomcat-embed-jasper-${tomcat.version}.jar"/>
            <url url="${central}/org/apache/tomcat/embed/tomcat-embed-el/${tomcat.version}/tomcat-embed-el-${tomcat.version}.jar"/>
            <url url="${central}/org/eclipse/jdt/ecj/${ecj.version}/ecj-${ecj.version}.jar"/>
        </get>
    </target>
</project>
