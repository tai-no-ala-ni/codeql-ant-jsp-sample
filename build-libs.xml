<?xml version="1.0" encoding="UTF-8"?>
<!-- 外部ライブラリを Maven Central から lib/ に取得する（取得済みならスキップ） -->
<project name="libs" default="fetch" basedir=".">
    <property name="lib.dir" value="${basedir}/lib"/>
    <property name="tomcat.version" value="10.1.60"/>
    <property name="ecj.version" value="3.33.0"/>
    <property name="central" value="https://repo1.maven.org/maven2"/>

    <target name="fetch">
        <mkdir dir="${lib.dir}"/>
        <get dest="${lib.dir}" skipexisting="true" usetimestamp="false">
            <url url="${central}/org/apache/tomcat/embed/tomcat-embed-core/${tomcat.version}/tomcat-embed-core-${tomcat.version}.jar"/>
            <url url="${central}/org/apache/tomcat/embed/tomcat-embed-jasper/${tomcat.version}/tomcat-embed-jasper-${tomcat.version}.jar"/>
            <url url="${central}/org/apache/tomcat/embed/tomcat-embed-el/${tomcat.version}/tomcat-embed-el-${tomcat.version}.jar"/>
            <url url="${central}/org/eclipse/jdt/ecj/${ecj.version}/ecj-${ecj.version}.jar"/>
        </get>
    </target>
</project>
