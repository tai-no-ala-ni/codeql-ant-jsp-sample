<?xml version="1.0" encoding="UTF-8"?>
<!--
  依存ライブラリの宣言専用（ビルドには Maven を使わず Ant を使う）。
  - GitHub の Dependency graph / Dependabot はこのファイルから依存を認識する。
  - build-libs.xml は <properties> のバージョンを読んで lib/ に jar を取得する。
    Dependabot がバージョンを上げる PR を作ると、そのまま Ant ビルドにも反映される。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>codeql-ant-jsp-sample</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <properties>
        <!-- 【検証用】あえて既知の脆弱性がある古いバージョンにしている（Dependabot alerts の確認用） -->
        <tomcat.version>10.1.0</tomcat.version>
        <ecj.version>3.33.0</ecj.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>${tomcat.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
            <version>${tomcat.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
            <version>${tomcat.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jdt</groupId>
            <artifactId>ecj</artifactId>
            <version>${ecj.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
